rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for checking authenticated status and user roles
    function isAuthenticated() {
      return request.auth != null;
    }

    // Safely reads the user document from the 'users' collection to check roles
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().role == role;
    }

    function isAdmin() {
      return isAuthenticated() && isRole('admin');
    }

    function isProfessor() {
      return isAuthenticated() && (
        isRole('professor') || 
        isAdmin()
      );
    }

    function isAluno() {
      return isRole('aluno') || (!isAdmin() && !isProfessor());
    }

    // TASK 2: Security Rules for the 'dados_academicos' collection
    match /dados_academicos/{document} {
      // 'admin': Full access (read & write)
      // 'professor': Read & write allowed
      // 'aluno': Read only allowed
      allow read: if isAuthenticated() && (isAdmin() || isProfessor() || isAluno());
      allow write: if isAuthenticated() && (isAdmin() || isProfessor());
    }

    // TASK 3 & Security: Security Rules for the 'users' collection
    match /users/{userId} {
      // Users can read any user profile (useful for directory listing / lookups in class views)
      // or at least their own profile
      allow read: if isAuthenticated();
      
      // Let anyone create their own profile during registration, 
      // but enforce that the default role MUST be 'aluno' unless created by an admin
      // or if they are bootstrapped admin/professor accounts
      allow create: if isAuthenticated() && 
                    request.auth.uid == userId && 
                    (
                      request.resource.data.role == 'aluno' || 
                      isAdmin()
                    );
      
      // Profile updates are only allowed by the user themselves (without changing their role) 
      // or by an admin (who can change roles manually)
      allow update: if isAuthenticated() && 
                    (isAdmin() || 
                    (request.auth.uid == userId && request.resource.data.role == resource.data.role));
      
      // Deletion is restricted to admins only
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Classes collection rules
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin() || 
        isProfessor() ||
        // Allow write if classes collection is completely empty (no '1a' document exists yet)
        !exists(/databases/$(database)/documents/classes/1a)
      );
    }

    // Exercises collection rules
    match /exercises/{exerciseId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin() || 
        isProfessor() ||
        // Allow write if exercises collection is completely empty (no 'ex01' document exists yet)
        !exists(/databases/$(database)/documents/exercises/ex01)
      );
    }

    // Students collection rules
    match /students/{studentId} {
      allow read: if isAuthenticated();
      // Students update their progress/status; Teachers/admins update everything
      // Also allow write if students collection is completely empty (no '202401' document exists yet)
      allow write: if isAuthenticated() || !exists(/databases/$(database)/documents/students/202401);
    }

    // Logs collection rules
    match /logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isAdmin() || isProfessor());
    }

    // Student progress collection rules
    match /student_progress/{progressId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
