# === BANCO DE DADOS NEON POSTGRESQL ===
# String de conexão completa (pooled, com SSL)
DATABASE_URL="postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/codetracker?sslmode=require"

# === NEON AUTH (Stack Auth) ===
NEON_AUTH_SECRET="sua-chave-secreta-neon-auth"
NEON_AUTH_JWKS_URL="https://api.stack-auth.com/api/v1/projects/SEU_PROJECT_ID/.well-known/jwks.json"
NEON_AUTH_PROJECT_ID="seu-project-id-neon-auth"

# === GEMINI AI ===
GEMINI_API_KEY="sua-chave-gemini-api"

# === FLASK ===
FLASK_ENV="development"
SESSION_SECRET="string-aleatoria-super-secreta-minimo-64-caracteres"

# === FRONTEND (build-time via Vite - precisam do prefixo VITE_) ===
VITE_NEON_AUTH_PROJECT_ID="seu-project-id-neon-auth"
VITE_NEON_AUTH_PUBLISHABLE_KEY="pk_sua_chave_publica_neon_auth"
VITE_API_URL="http://localhost:5000"

# === NEON (GitHub Actions - NÃO usar no .env local) ===
# Configure estes como GitHub Secrets, não aqui:
# NEON_API_KEY="sua-neon-api-key"
# NEON_PROJECT_ID="seu-neon-project-id"
